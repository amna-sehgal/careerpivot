# ─── MongoDB ───────────────────────────────────────────────────────────────
# Free cluster at https://cloud.mongodb.com
# Create cluster → Connect → Drivers → copy connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerpivot?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────────────────
# Any random long string — keep it secret
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production

# ─── OpenRouter ─────────────────────────────────────────────────────────────
# Free API key at https://openrouter.ai/keys
# Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
